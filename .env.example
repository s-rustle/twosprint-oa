# Cohort room URLs for Daily.co (6 classrooms).
# Copy to .env.local and fill in. On Vercel: Project → Settings → Environment Variables.

# Option 1: Single JSON array of 6 Daily room URLs
NEXT_PUBLIC_COHORT_ROOM_URLS=["https://your-domain.daily.co/room1","https://your-domain.daily.co/room2","https://your-domain.daily.co/room3","https://your-domain.daily.co/room4","https://your-domain.daily.co/room5","https://your-domain.daily.co/room6"]

# Option 2: Six separate variables (uncomment and set)
# NEXT_PUBLIC_DAILY_COHORT_1_URL=https://your-domain.daily.co/room1
# NEXT_PUBLIC_DAILY_COHORT_2_URL=https://your-domain.daily.co/room2
# NEXT_PUBLIC_DAILY_COHORT_3_URL=https://your-domain.daily.co/room3
# NEXT_PUBLIC_DAILY_COHORT_4_URL=https://your-domain.daily.co/room4
# NEXT_PUBLIC_DAILY_COHORT_5_URL=https://your-domain.daily.co/room5
# NEXT_PUBLIC_DAILY_COHORT_6_URL=https://your-domain.daily.co/room6
